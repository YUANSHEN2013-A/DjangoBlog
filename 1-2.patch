diff --git a/deploy/entrypoint.sh b/deploy/entrypoint.sh
index 801df4d..38c152c 100644
--- a/deploy/entrypoint.sh
+++ b/deploy/entrypoint.sh
@@ -25,9 +25,44 @@ python manage.py makemigrations && \
   mkdir -p collectedstatic/blog/dist/.vite && \
   cp -r blog/static/blog/dist/.vite/* collectedstatic/blog/dist/.vite/ && \
   python manage.py compress --force && \
-  python manage.py build_index && \
   python manage.py compilemessages  || exit 1
 
+if [ -n "$DJANGO_ELASTICSEARCH_HOST" ]; then
+    echo "Waiting for Elasticsearch to be available..."
+    ES_URL="$DJANGO_ELASTICSEARCH_HOST"
+    if [[ $ES_URL != http* ]]; then
+        ES_URL="http://$ES_URL"
+    fi
+    
+    until curl -s "$ES_URL/_cluster/health" | grep -q '"status":"\(green\|yellow\)"'; do
+        echo "Elasticsearch is unavailable - sleeping"
+        sleep 2
+    done
+    echo "Elasticsearch is up!"
+    
+    echo "Creating djangoblog index with IK analyzer..."
+    curl -s -X PUT "$ES_URL/djangoblog" -H 'Content-Type: application/json' -d'
+    {
+      "settings": {
+        "index": {
+          "analysis": {
+            "analyzer": {
+              "default": {
+                "type": "ik_max_word"
+              },
+              "default_search": {
+                "type": "ik_smart"
+              }
+            }
+          }
+        }
+      }
+    }' || true
+
+    echo "Building index..."
+    python manage.py build_index || exit 1
+fi
+
 exec gunicorn ${DJANGO_WSGI_MODULE}:application \
 --name $NAME \
 --workers $NUM_WORKERS \
diff --git a/deploy/nginx.conf b/deploy/nginx.conf
index 32161d8..230b38d 100644
--- a/deploy/nginx.conf
+++ b/deploy/nginx.conf
@@ -27,14 +27,31 @@ http {
 
   #gzip  on;
 
+  # Define resolver for Docker internal DNS to avoid startup failure when Kibana is not running
+  resolver 127.0.0.11 valid=30s;
+
   server {
     root /code/djangoblog/collectedstatic/;
     listen 80;
     keepalive_timeout 70;
+    
     location /static/ {
       expires max;
       alias /code/djangoblog/collectedstatic/;
     }
+
+    # Kibana Reverse Proxy
+    location /kibana/ {
+      auth_basic "Kibana Restricted Access";
+      auth_basic_user_file /etc/nginx/.htpasswd;
+      
+      set $kibana_backend http://kibana:5601;
+      proxy_pass $kibana_backend;
+      proxy_set_header Host $http_host;
+      proxy_set_header X-Real-IP $remote_addr;
+      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+    }
+
     location / {
       proxy_set_header X-Real-IP $remote_addr;
       proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
